      "ruleId": "rule-R-01",
      "ruleCode": "R-01",
      "isWhitelistAllowed": true,
      "definition": {
        "match": "any",
        "features": [
          "day_volume_czk",
          "client_projected_monthly_volume_czk",
          "client_q2_daily_avg_volume_czk",
          "tx_amount_czk",
          "client_q2_max_tx_czk"
        ],
        "conditions": [
          {
            "id": "a",
            "op": ">",
            "left": {
              "feature": "day_volume_czk"
            },
            "label": "Denní objem > 0,25 × očekávaný měsíční objem",
            "right": {
              "expr": "0.25 × client_projected_monthly_volume_czk"
            }
          },
          {
            "id": "b",
            "op": ">",
            "left": {
              "feature": "day_volume_czk"
            },
            "label": "Denní objem > 3 × průměrný denní objem za 2Q2026",
            "right": {
              "expr": "3 × client_q2_daily_avg_volume_czk"
            }
          },
          {
            "id": "c",
            "op": ">",
            "left": {
              "feature": "tx_amount_czk"
            },
            "label": "Transakce > 2 × největší transakce za 2Q2026",
            "right": {
              "expr": "2 × client_q2_max_tx_czk"
            }
          }
        ]
      },
      "baseScore": 58,
      "sensitivity": 100,
      "riskProfiles": ["low", "medium", "high"]
    },
