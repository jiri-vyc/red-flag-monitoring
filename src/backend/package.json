{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "test": "jest",
    "typeorm": "tsx --env-file-if-exists=.env \"$(command -v typeorm)\"",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/cliDataSource.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/database/cliDataSource.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/infrastructure/database/cliDataSource.ts",
    "migration:generate": "sh -c 'npm run typeorm -- migration:generate -d src/infrastructure/database/cliDataSource.ts --pretty src/infrastructure/database/migrations/\"$0\"'",
    "migration:create": "sh -c 'npm run typeorm -- migration:create src/infrastructure/database/migrations/\"$0\"'",
    "demo:rule-extraction": "tsx --env-file-if-exists=.env src/delivery/cli/demoRuleExtraction.ts",
    "demo:policy-drafting": "tsx --env-file-if-exists=.env src/delivery/cli/demoPolicyDrafting.ts",
    "demo:hello-world": "tsx --env-file-if-exists=.env src/delivery/cli/demoHelloWorld.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@aws-sdk/client-lambda": "^3.1153.0",
    "@aws-sdk/rds-signer": "^3.1152.0",
    "@aws/bedrock-token-generator": "^1.1.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
