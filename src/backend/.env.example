# HTTP port of the API server.
PORT=4000

# Postgres connection string. Matches the defaults in src/docker-compose.yml.
DATABASE_URL=postgres://red_flag:red_flag_local@localhost:5434/red_flag_monitoring

# Aurora (database-1) instead of local Docker: IAM token auth, so no password in the URL.
# Use your own wip_<name> database; main only receives reviewed migrations.
# DATABASE_AUTH=iam
# DATABASE_URL=postgres://postgres@database-1.cluster-c9m6a2a047k1.eu-central-1.rds.amazonaws.com:5432/wip_<name>
# AWS_REGION=eu-central-1
# AWS_PROFILE=hackathon
