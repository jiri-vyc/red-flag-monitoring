# HTTP port of the API server.
PORT=4000

# --- Option A: local Docker Postgres (npm run db:up). Matches the defaults in src/docker-compose.yml.
DATABASE_URL=postgres://red_flag:red_flag_local@localhost:5434/red_flag_monitoring

# --- Option B: Aurora database-1 in the team account 526983806399.
# Comment out option A and uncomment the four lines below.
# - Sign in first: aws sso login --sso-session hackathon
# - IAM token auth: no password in the URL, the backend signs a fresh token per connection.
# - Database: main (shared; run only reviewed migrations against it) or your own wip_<name> (db/create-wip.sh <name>).
# - Endpoint: aws rds describe-db-clusters --db-cluster-identifier database-1 --query 'DBClusters[0].Endpoint' --output text
# - Check: the sidebar's Database panel, or curl localhost:4000/api/database-status
# - Profile: use hackathon-sdk (credential_process over the CLI's 12 h role credentials, see the root README).
#   A plain SSO profile fails after 1 h with "Token is expired" because the SDK cannot refresh the SSO token.
# DATABASE_AUTH=iam
# DATABASE_URL=postgres://postgres@database-1.cluster-c9m6a2a047k1.eu-central-1.rds.amazonaws.com:5432/main
# AWS_REGION=eu-central-1
# AWS_PROFILE=hackathon-sdk

# Wizard drafts (regulation → policy, policy → rules): "dummy" (default, no LLM) or "bedrock".
# DRAFT_GENERATOR=bedrock

# Amazon Bedrock (drafting and the demo:* scripts). Without AWS_BEARER_TOKEN_BEDROCK a short-term (max 12 h) API key
# is generated from the AWS credential chain, e.g. after `aws sso login --profile <profile>`.
# Uses the same AWS_PROFILE as the database above (one profile per process); hackathon-sdk works for both.
# BEDROCK_REGION=eu-central-1
# BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-5-20251101-v1:0
# "short_term_api_key" (default) or "iam" (signs with the AWS credentials, used by the drafting worker Lambda).
# BEDROCK_AUTH=iam
# AWS_BEARER_TOKEN_BEDROCK=

# Rule gap review (spec/rule-gap-hunting.md): where reports are written (default backend/.rule-reviews, git-ignored),
# and "bedrock" to switch on the Bedrock explanations and hypotheses (step 1b, not wired yet; default "off").
# RULE_REVIEW_DIR=
# RULE_REVIEW_LLM=off
