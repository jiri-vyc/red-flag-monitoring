{
  "name": "red-flag-monitoring",
  "private": true,
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names backend,web --prefix-colors blue,magenta \"npm run dev -w backend\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "migration:run": "npm run migration:run -w backend",
    "migration:revert": "npm run migration:revert -w backend",
    "migration:show": "npm run migration:show -w backend",
    "migration:generate": "npm run migration:generate -w backend --",
    "migration:create": "npm run migration:create -w backend --",
    "deploy": "../deploy/all.sh",
    "deploy:roles": "../deploy/roles.sh",
    "deploy:api": "../deploy/api.sh",
    "deploy:drafting-worker": "../deploy/drafting-worker.sh",
    "deploy:web": "../deploy/web.sh",
    "demo:policy-drafting": "npm run demo:policy-drafting -w backend --",
    "demo:hello-world": "npm run demo:hello-world -w backend",
    "demo:rule-drafting": "npm run demo:rule-drafting -w backend --"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
