{
  "name": "red-flag-monitoring",
  "private": true,
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names backend,web --prefix-colors blue,magenta \"npm run dev -w backend\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
