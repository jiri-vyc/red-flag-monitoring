# Default data source for every feature service: "mock" (browser-only demo data) or "live" (calls /api/...).
NEXT_PUBLIC_API_MODE=mock

# Optional per-service overrides, e.g. switch only rules to the real backend.
# NEXT_PUBLIC_API_MODE_REGULATIONS=live
# NEXT_PUBLIC_API_MODE_POLICIES=live
# NEXT_PUBLIC_API_MODE_RULES=live
# NEXT_PUBLIC_API_MODE_BATCHES=live
# NEXT_PUBLIC_API_MODE_WIZARD=live
# NEXT_PUBLIC_API_MODE_DASHBOARD=live

# Recommended live setup against the backend (copy to .env.local, restart `npm run dev -w web`):
#   NEXT_PUBLIC_API_MODE=live
# The wizard is live too (regulation text or MD file → policy drafts → rule drafts on approval). It is shown only when
# it shares the data source with regulations, policies and rules, so do not pin it to another mode.
# The live dashboard is composed on the web from the live rules, regulations, policies and evaluation-runs endpoints. Features the API lacks (CSV upload,
# starting a run, URL sources in the wizard, draft editing, deterministic rule generation) are hidden or disabled in live mode through service
# capabilities, see backend-todo.md.
# Live writes use the backend's seeded admin user (config/currentUser.ts) as author and reviewer.

# Backend base URL, server-only. Used by the /api/* proxy in next.config.ts.
BACKEND_URL=http://localhost:4000

# Future secrets (API keys etc.) must be server-only (no NEXT_PUBLIC_ prefix) and are passed to the Web Function at deploy time (deploy/web.sh), never here.
