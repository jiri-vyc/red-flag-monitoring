# Copy to .env.local and restart `npm run dev`. NEXT_PUBLIC_* values are read at start/build time.

# Default data source: "live" (backend API via /api/*) or "mock" (browser-only demo data, no backend needed).
# This is only the default. The sidebar's "Data source: Mock / Live" switch overrides it per browser (localStorage).
# Mock runs every feature, including those the API lacks. Live hides or disables what the API cannot do yet
# (CSV upload, draft editing, deterministic rule generation in the manual rule form).
NEXT_PUBLIC_API_MODE=live

# Optional per-service pin in live mode, e.g. keep one section on mock while its API is unfinished.
# Leave unset normally: the wizard is shown only when it shares the data source with regulations, policies and rules.
# NEXT_PUBLIC_API_MODE_REGULATIONS=mock
# NEXT_PUBLIC_API_MODE_POLICIES=mock
# NEXT_PUBLIC_API_MODE_RULES=mock
# NEXT_PUBLIC_API_MODE_BATCHES=mock
# NEXT_PUBLIC_API_MODE_WIZARD=mock
# NEXT_PUBLIC_API_MODE_DASHBOARD=mock
# NEXT_PUBLIC_API_MODE_USERS=mock
# NEXT_PUBLIC_API_MODE_TRANSACTIONS=mock
# NEXT_PUBLIC_API_MODE_FAU_REPORTS=mock

# Backend base URL, server-only. Used by the /api/* proxy in next.config.ts (baked into the rewrite at build time).
# Local backend: http://localhost:4000 (see src/README.md, "Against Aurora instead of Docker").
BACKEND_URL=http://localhost:4000

# Live writes use the backend's seeded admin user (config/currentUser.ts) as author and reviewer.
# Secrets (API keys etc.) must be server-only (no NEXT_PUBLIC_ prefix) and are passed to the Web Function at deploy time
# (deploy/web.sh), never committed here.
